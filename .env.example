# Copy this file to .env and fill in the values. Never commit .env (this repo is public).
# Only names live here; add a name when an issue needs a new secret or setting.

# Azure ML workspace (scripts in searchashouses/azureml/setup/)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=
AZURE_LOCATION=

# LLM for the review note (only if Azure OpenAI is chosen)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# HuggingFace Hub (publishing the matcher)
HF_TOKEN=

# Postgres in the local Kubernetes cluster
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
